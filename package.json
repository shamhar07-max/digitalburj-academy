{
  "name": "digitalburj-academy",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Burj Academy \u2014 learning + building + assessment platform (vertical slice: auth, missions, submissions, review, evidence).",
  "scripts": {
    "install:web": "npm --prefix apps/web install",
    "db:migrate": "node apps/web/src/server/migrate.js",
    "db:seed": "node apps/web/src/server/seed.js",
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "test": "node --test tests/*.test.mjs",
    "curriculum:validate": "npx -y tsx scripts/validate-curriculum.ts"
  }
}